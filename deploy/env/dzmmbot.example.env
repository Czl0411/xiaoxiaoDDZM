DZMM_SERVER_MODE=1
DZMM_REQUIRE_ADMIN_AUTH=1
DZMM_ADMIN_USERNAME=admin
DZMM_ADMIN_PASSWORD_HASH=replace-with-pbkdf2-hash
DZMM_EXTRA_ADMIN_USERNAME=
DZMM_EXTRA_ADMIN_PASSWORD_HASH=
DZMM_DATA_DIR=/var/lib/dzmmbot/data
DZMM_SKIP_AUTO_OPEN=1
DISPLAY=:99
PYTHONUNBUFFERED=1
PLAYWRIGHT_BROWSERS_PATH=/opt/dzmmbot/playwright
